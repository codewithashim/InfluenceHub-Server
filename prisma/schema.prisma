// This is your Prisma schema file. Define your data models here.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  viewer
}

enum Platform {
  instagram
  tiktok
  youtube
  x
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(viewer)
  createdAt    DateTime @default(now())
}


model Influencer {
  id             String    @id @default(cuid())
  name           String
  platform       Platform
  username       String
  followers      Int       @default(0)
  engagementRate Decimal   @db.Decimal(5,2)
  country        String?
  categories     String[]
  email          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([platform, username])
  @@index([followers])
  @@index([engagementRate])
  @@index([platform])
  @@index([country])
}
